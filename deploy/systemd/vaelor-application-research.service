[Unit]
Description=Vaelor bounded public application research broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vaelor-research
Group=vaelor
ExecStart=/opt/vaelor/venv/bin/vaelor-application-research
Restart=on-failure
RestartSec=3
Environment=VAELOR_RUN_ROOT=/run/vaelor
Environment=VAELOR_APPLICATION_RESEARCH_SOCKET=/run/vaelor/application-research.sock
UMask=0007
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/run/vaelor
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
