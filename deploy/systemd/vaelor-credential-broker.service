[Unit]
Description=Vaelor encrypted credential broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vaelor-secrets
Group=vaelor-credentials
ExecStart=/opt/vaelor/venv/bin/vaelor-credential-broker
Restart=on-failure
RestartSec=3
StateDirectory=vaelor/credentials
StateDirectoryMode=0700
LoadCredentialEncrypted=master.key:/etc/vaelor/credentials/master-key.cred
Environment=VAELOR_CREDENTIAL_BROKER_SOCKET=/run/vaelor/credentiald.sock
Environment=VAELOR_CREDENTIAL_VAULT_DB=/var/lib/vaelor/credentials/vault.sqlite3
UMask=0007
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
