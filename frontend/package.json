{
  "name": "vaelor-control-plane",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "design:check": "node scripts/design-system-check.mjs",
    "build": "npm run design:check && tsc --noEmit -p tsconfig.app.json && vite build --config vite.config.ts",
    "check": "npm run acceptance:self-test && npm run design:check && tsc --noEmit -p tsconfig.app.json --pretty false",
    "test": "vitest run",
    "acceptance:responsive": "node scripts/responsive-acceptance.mjs",
    "acceptance:self-test": "node scripts/responsive-acceptance.mjs --self-test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^27.3.0",
    "playwright-core": "^1.62.0",
    "vitest": "^4.0.16"
  }
}
