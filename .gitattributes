# Every text file is LF in the index AND in what `git archive` emits, whatever
# core.autocrlf says on the checkout that builds a release: a Windows checkout
# shipped requirements-release.txt with CRLF (wave 6 deploy, LESSONS 18).
# *.ps1 below keeps CRLF on purpose; binaries are named so no heuristic decides.
* text=auto eol=lf

*.py text eol=lf
*.sh text eol=lf
*.service text eol=lf
*.socket text eol=lf
*.conf text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.woff2 binary
*.gguf binary
*.deb binary
*.whl binary
*.gz binary
*.gpg binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
